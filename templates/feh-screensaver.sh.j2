#!/bin/bash
IDLE_TIME={{ kiosk_chromium_enabled | ternary(kiosk_idle_ms, 0) }}

FILELIST="{{ kiosk_slideshow_filelist }}"

PICTURES_DIR="{{ kiosk_slideshow_image_dir }}"
DIR_SIGNATURE=0

ORIENTATION="{{ kiosk_slideshow_orientation }}"
DISPLAY=${DISPLAY:-:0}
{% if kiosk_slideshow_orientation == 'portrait' %}
xrandr --output HDMI-1 --rotate right
{% endif %}

dir_signature() {
    if [[ ! -d "$PICTURES_DIR" ]]; then
        echo ""
        return
    fi

    local filehash
    filehash=$(find "$PICTURES_DIR" -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.gif' -o -iname '*.bmp' -o -iname '*.tiff' -o -iname '*.webp' -o -iname '*.heic' \) -printf '%P\t%T@\n' 2>/dev/null | sort | md5sum | awk '{print $1}')
    echo "${filehash}"
}

build_filelist() { 
    local tmpfile file dims width height
    tmpfile=$(mktemp) || return 1 # Ensure we have a temp file to work with

    if [[ ! -d "$PICTURES_DIR" ]]; then
        rm -f "$tmpfile"
        return 1
    fi

    if [[ "$ORIENTATION" == "all" ]]; then
        find "$PICTURES_DIR" -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.gif' -o -iname '*.bmp' -o -iname '*.tiff' -o -iname '*.webp' -o -iname '*.heic' \) -print0 2>/dev/null | sort -z | while IFS= read -r -d '' file; do
            printf '%s\n' "$file"
        done > "$tmpfile"
    else
        find "$PICTURES_DIR" -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.gif' -o -iname '*.bmp' -o -iname '*.tiff' -o -iname '*.webp' -o -iname '*.heic' \) -print0 2>/dev/null | sort -z | while IFS= read -r -d '' file; do
            if dims=$(identify -format '%w %h' "$file" 2>/dev/null); then
                width=${dims%% *}
                height=${dims##* }
                if [[ "$ORIENTATION" == "landscape" && $width -ge $height ]] || [[ "$ORIENTATION" == "portrait" && $height -ge $width ]]; then
                    printf '%s\n' "$file"
                fi
            fi
        done > "$tmpfile"
    fi

    if [[ ! -f "$FILELIST" ]] || ! cmp -s "$tmpfile" "$FILELIST"; then
        rm "$FILELIST"
        mv "$tmpfile" "$FILELIST"
        chmod 0644 "$FILELIST"
        return 0
    fi

    rm -f "$tmpfile"
    return 1
}

start_feh() {
    if [[ -f "$FILELIST" ]]; then
        feh -z -Y -x -q -D {{ kiosk_slideshow_delay }} -B black -F -Z --filelist "$FILELIST" 2>/dev/null &
    else
        feh -z -Y -x -q -D {{ kiosk_slideshow_delay }} -B black -F -Z -r "$PICTURES_DIR" 2>/dev/null &
    fi
}

# Build initial filelist if it doesn't exist
if [[ ! -f "$FILELIST" ]]; then
    build_filelist
fi

while true; do
    IDLE=$(xprintidle 2>/dev/null || echo 0)
    FILELIST_CHANGED=0

    # Always check for filelist changes, regardless of idle state
    CURRENT_SIG=$(dir_signature)
    if [[ "$CURRENT_SIG" != "$DIR_SIGNATURE" ]]; then
        build_filelist
        FILELIST_CHANGED=1
        DIR_SIGNATURE="$CURRENT_SIG"
    fi

    if [[ $IDLE -gt $IDLE_TIME ]]; then

        # If the filelist has changed, make sure to shutdown feh so it can be restarted with the new list
        if [[ $FILELIST_CHANGED -eq 1 ]]; then
                killall feh 2>/dev/null
        fi

        # start feh if it's not already running
        if ! pgrep -x "feh" > /dev/null 2>&1; then
            start_feh
        fi
    else
        if pgrep -x "feh" > /dev/null 2>&1; then
            killall feh 2>/dev/null
        fi

    fi

    sleep 1
done
